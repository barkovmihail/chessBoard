{
  "name": "chess-board",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "vite",
    "backend": ".venv/bin/python -m uvicorn backend.api:app --host 127.0.0.1 --port 8011",
    "build": "npm run typecheck && vite build --outDir build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/react": "18.0.25",
    "@types/react-dom": "18.0.8",
    "typescript": "4.8.4",
    "vite": "7.3.6"
  }
}
